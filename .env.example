# Launch Profile (M012-B2): lite | smart | full
# Normally set by `python -m src.launcher --profile ...`; override here to force
# a default when starting the app directly. Explicit values always win over
# profile defaults.
PIS_LAUNCH_PROFILE=smart

# AI mode: local | hybrid | api | auto (profile default: lite=local, smart/full=auto)
PIS_AI_MODE=auto
# Remote-content privacy policy stays `never` by default in every profile.
PIS_REMOTE_CONTENT_POLICY=never
# Set to 1 to expose a capability the profile hides, e.g.:
# PIS_FEATURE_AI_CHAT=1
# PIS_FEATURE_VISUALIZATIONS=1

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tb36_index
POSTGRES_USER=tb36_user
POSTGRES_PASSWORD=your_secure_password

# Storage Paths
SCAN_PATHS=C:\
DATA_DIR=./data
CACHE_DIR=./data/cache

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=mixtral:8x7b
VISION_MODEL=llava

# Performance Settings
BATCH_SIZE=100
MAX_WORKERS=8
GPU_ENABLED=true
MAX_FILE_SIZE_GB=1

# Security
ENCRYPTION_KEY=generate_with_fernet
JWT_SECRET=your_jwt_secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Development
DEBUG=false
LOG_LEVEL=INFO
PROFILE_PERFORMANCE=false

# Features
ENABLE_OCR=true
ENABLE_EMAIL_EXTRACTION=true
ENABLE_VISUALIZATION=true
ENABLE_AUTO_CLASSIFICATION=true