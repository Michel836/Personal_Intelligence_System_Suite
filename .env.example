# 36TB Intelligence — environment template
#
# The canonical runtime is environment-driven: copy this file to `.env` only if
# your shell loads it (e.g. `set -a; source .env; set +a`). Code defaults are
# already safe: local-only, XDG paths, remote content policy `never`.

# ---------------------------------------------------------------------------
# Launch profile: lite | smart | full (set by the launcher, override to force)
# ---------------------------------------------------------------------------
PIS_LAUNCH_PROFILE=smart
PIS_AI_MODE=auto
# Never send document content to a remote provider unless explicitly changed.
PIS_REMOTE_CONTENT_POLICY=never
# Expose a capability a profile hides: PIS_FEATURE_AI_CHAT=1, etc.
# PIS_FEATURE_AI_CHAT=1

# ---------------------------------------------------------------------------
# Data locations (absolute XDG defaults; override for trials / external disks)
# ---------------------------------------------------------------------------
# PIS_DATA_DIR=~/.local/share/pis
# PIS_DB_PATH=~/.local/share/pis/indexes/files.db
# PIS_EMBEDDING_STORE_DIR=~/.local/share/pis/cache/embeddings
# PIS_EXPORT_DIR=~/.pis-exports
# PIS_BACKUP_DIR=~/.pis-backups
# PIS_STATE_DIR=~/.local/state/pis
# PIS_CACHE_DIR=~/.cache/pis
#
# Set to 1 to disable the one-time migration of a legacy ./data tree:
# PIS_NO_AUTO_MIGRATE=1

# ---------------------------------------------------------------------------
# Scan policy
# ---------------------------------------------------------------------------
# Safe partial scans are the default: unreadable subtrees are recorded and
# excluded from reconciliation. Set to 0 for strict fail-closed behaviour.
PIS_SCAN_IGNORE_ERRORS=1
# Extra exclusions (comma-separated names, globs or paths):
# PIS_SCAN_EXCLUDE_DIRS=node_modules,*.tmp,/mnt/backup

# ---------------------------------------------------------------------------
# Logging (CLI: -v/--verbose and -q/--quiet take precedence)
# ---------------------------------------------------------------------------
LOG_LEVEL=WARNING
DEBUG=false

# ---------------------------------------------------------------------------
# Optional AI backends
# ---------------------------------------------------------------------------
# Local Ollama (only used when PIS_AI_MODE allows it):
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=llama3.2
# Optional remote OpenAI-compatible endpoint. Requires an explicit content
# policy (extracted_text) and a key; never enabled by default.
# PIS_API_BASE_URL=https://api.example/v1
# PIS_API_KEY=
# PIS_API_LLM_MODEL=
# PIS_API_EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Optional system tools (detected, never required)
# ---------------------------------------------------------------------------
# tesseract (OCR), libreoffice/soffice (legacy Office + PDF export),
# 7z (CHM), readpst (PST/OST), google-chrome/chromium (alt PDF).

# ---------------------------------------------------------------------------
# Optional PostgreSQL/pgvector backend (canonical store stays SQLite)
# ---------------------------------------------------------------------------
# PIS_PG_URL=postgresql://user:password@localhost:5432/pis
